{
  "_comment": "Moteur memoire Token Savior pour OpenAI Codex CLI. Merge dans ~/.codex/hooks.json (ou <projet>/.codex/hooks.json). ATTENTION unites: les timeouts Codex sont en SECONDES, ceux de Claude Code en millisecondes -- ne pas recopier memory-hooks-config.json tel quel. Les six evenements ci-dessous ont ete extraits du binaire codex 0.145.0 (strings), qui expose exactement: SessionStart, SessionEnd, PreToolUse, PostToolUse, UserPromptSubmit, PreCompact, Notification, SubagentStop. Sans equivalent Codex donc non portes: Stop, StopFailure, ConfigChange.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{TS_HOOKS_DIR}}/memory-session-start.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{TS_HOOKS_DIR}}/memory-userprompt.sh",
            "timeout": 1
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{TS_HOOKS_DIR}}/memory-precompact.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{TS_HOOKS_DIR}}/memory-session-stop.sh end",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__token-savior[\\w-]*__(get_function_source|get_class_source|get_edit_context|find_symbol))$",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{TS_HOOKS_DIR}}/memory-pretooluse.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|WebFetch|web_fetch)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{TS_HOOKS_DIR}}/memory-posttooluse.sh",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
